# ============================================================
#  CryptographyTube — ONE-PLACE DOMAIN CONFIG (template)
#  ------------------------------------------------------------
#  1. Copy this file to ".env"      (cp .env.example .env)
#  2. Put YOUR domain below.
#  3. Run:   python build_domain.py
#  4. Deploy (git push for GitHub Pages, or upload to cPanel public_html).
#
#  Nothing else to edit anywhere — this is the single source of truth.
# ============================================================

# Full site URL (with https://). This is the canonical address.
SITE_URL=https://example.com

# Bare host written to the CNAME file (GitHub Pages custom domain).
# Apex (example.com) or www (www.example.com) — your choice.
SITE_DOMAIN=example.com

# Optional backend API endpoints. Leave EMPTY for the normal
# static/client-side site (same-origin). Only set if you run a backend.
API_BASE_URL=
API_SOCKET_URL=

# Also rebrand the old footer "main site" links (cryptographytube.com)
# to your domain? true = yes (recommended when fully rebranding).
REPLACE_LEGACY_DOTCOM=true
